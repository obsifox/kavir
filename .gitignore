# Build artifacts
/target/
/build/
/dist/
node_modules/
__pycache__/
*.pyc
*.o

# Compiler binaries (M1.1: never track binaries)
compiler/kavir
compiler/kavir-asan
compiler/kavir-libfuzzer
compiler/prog
compiler/corpus/

# Fuzz crash artifacts are kept locally for triage only
fuzz-crash-*

# Local environment / secrets — never commit
.env
.secrets/
*.local

# Benchmark artifacts (binaries and generated assembly are not sources)
/benchmarks/**/bin_*
/benchmarks/**/*.s

# Editor
.idea/
.vscode/
*.swp
.DS_Store
