// truncated division: sign matrix + edge dividends
fn main() -> i32 {
    print(7 / 2);
    print(" ");
    print(-7 / 2);
    print(" ");
    print(7 / -2);
    print(" ");
    print(-7 / -2);
    print(" ");
    print(0 / 5);
    print(" ");
    print(-2147483648 / 1);
    print("\n");
    return 0;
}
