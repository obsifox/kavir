// M4 fixture (ADR-011): generated by scripts/gen_m4_fixtures.py
struct Pair {
    lo: i32,
    hi: i32,
}

struct Tri {
    a: i32,
    b: i32,
    c: i32,
}

struct Pent {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
}

struct Point {
    x: i32,
    y: i32,
}

struct Quad {
    tl: Point,
    br: Point,
}
// Recursion to the frame limit carrying an aggregate argument; the
// depth trap bytes are unchanged by M4 (ADR-010 3b; ADR-011 keeps the
// depth discipline identical in the interpreter and the ELF).
fn down(n: i32, p: Pair) -> i32 {
    let q: Pair = Pair { lo: p.lo + 1, hi: p.hi };
    if (n == 0) { return q.lo; }
    return down(n - 1, q);
}

fn deep(n: i32) -> i32 {
    return deep(n + 1);
}

fn main() -> i32 {
    print(down(1022, Pair { lo: 0, hi: 0 }));
    print(1);
    print(deep(0));
    print(2);
    return 0;
}
