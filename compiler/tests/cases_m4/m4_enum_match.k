// M4 fixture (ADR-011): generated by scripts/gen_m4_fixtures.py
struct Pair {
    lo: i32,
    hi: i32,
}

struct Tri {
    a: i32,
    b: i32,
    c: i32,
}

struct Pent {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
}

struct Point {
    x: i32,
    y: i32,
}

struct Quad {
    tl: Point,
    br: Point,
}
enum Shape {
    Dot,
    Circle(i32),
    Rect(i32, i32),
}

enum Res {
    Ok(Point),
    Bad,
}
// Enums: constructors (bare and payload-carrying), exhaustive match
// with payload binding, and the wildcard as the final arm.
fn area(s: Shape) -> i32 {
    return match s {
        Shape.Dot => 0,
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect(w, h) => w * h,
    };
}

fn label(s: Shape) -> i32 {
    return match s {
        Shape.Dot => 1,
        _ => 2,
    };
}

fn nested(s: Shape) -> i32 {
    let mut i: i32 = 0;
    let mut acc: i32 = 0;
    while (i < 3) {
        acc = acc + match s {
            Shape.Dot => 1,
            Shape.Circle(r) => r,
            Shape.Rect(w, h) => w + h,
        };
        i = i + 1;
    }
    return acc;
}

fn handle(r: Res) -> i32 {
    return match r {
        Res.Ok(p) => p.x + p.y,
        Res.Bad => 0 - 99,
    };
}

fn main() -> i32 {
    print(area(Shape.Dot));
    print(area(Shape.Circle(4)));
    print(area(Shape.Rect(3, 5)));
    print(label(Shape.Dot));
    print(label(Shape.Circle(1)));
    print(nested(Shape.Rect(2, 3)));
    print(handle(Res.Ok(Point { x: 2, y: 3 })));
    print(handle(Res.Bad));
    return 0;
}
