// M4 fixture (ADR-011): generated by scripts/gen_m4_fixtures.py
struct Pair {
    lo: i32,
    hi: i32,
}

struct Tri {
    a: i32,
    b: i32,
    c: i32,
}

struct Pent {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
}

struct Point {
    x: i32,
    y: i32,
}

struct Quad {
    tl: Point,
    br: Point,
}
// Struct value semantics: field read, field assignment through
// 'let mut', whole-value assignment, and copy-on-binding (aliasing is
// never observable -- ADR-011).
fn main() -> i32 {
    let mut p: Point = Point { x: 3, y: 4 };
    print(p.x + p.y);
    p.x = 10;
    print(p.x);
    print(p.y);
    let mut q: Point = p;
    q.x = 99;
    print(p.x);
    print(q.x);
    let mut r: Point = Point { x: 0, y: 0 };
    r = q;
    r.y = 7;
    print(q.y);
    print(r.x);
    print(r.y);
    return 0;
}
