// M4 fixture (ADR-011): generated by scripts/gen_m4_fixtures.py
struct Pair {
    lo: i32,
    hi: i32,
}

struct Tri {
    a: i32,
    b: i32,
    c: i32,
}

struct Pent {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
}

struct Point {
    x: i32,
    y: i32,
}

struct Quad {
    tl: Point,
    br: Point,
}
// Struct-in-struct: two-level field paths for read and write; nested
// literals; aggregate field assignment (whole value, same type).
fn main() -> i32 {
    let mut q: Quad = Quad { tl: Point { x: 1, y: 2 },
                             br: Point { x: 3, y: 4 } };
    print(q.tl.x);
    print(q.tl.y);
    print(q.br.x);
    print(q.br.y);
    q.br.x = 30;
    print(q.br.x);
    q.tl = Point { x: 10, y: 20 };
    print(q.tl.x);
    print(q.tl.y);
    let mut inner: Point = q.br;
    inner.x = 5;
    print(q.br.x);
    print(inner.x);
    return 0;
}
