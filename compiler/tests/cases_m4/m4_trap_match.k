// M4 fixture (ADR-011): generated by scripts/gen_m4_fixtures.py
struct Pair {
    lo: i32,
    hi: i32,
}

struct Tri {
    a: i32,
    b: i32,
    c: i32,
}

struct Pent {
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
}

struct Point {
    x: i32,
    y: i32,
}

struct Quad {
    tl: Point,
    br: Point,
}
enum Shape {
    Dot,
    Circle(i32),
    Rect(i32, i32),
}

enum Res {
    Ok(Point),
    Bad,
}
// Traps inside a match arm: the arm's operator position is the trap
// site; stdout shows the prints that ran before the trap.
fn area(s: Shape) -> i32 {
    return match s {
        Shape.Dot => 0,
        Shape.Circle(r) => r * 2147483647,
        Shape.Rect(w, h) => w * h,
    };
}

fn main() -> i32 {
    print(1);
    print(area(Shape.Dot));
    print(2);
    print(area(Shape.Circle(3)));
    print(3);
    return 0;
}
