// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 4 bytes (1 words), locals=3, kind=chain, ctx=s7.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S1 {
    f0: i32,
}

fn scal(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32) -> i32 {
    return a + 2 * b + 4 * c + 8 * d + 16 * e + 32 * f + 64 * g;
}

fn hop3(a: i32, b: i32, c: i32, x: S1, d: i32, e: i32, f: i32, g: i32) -> S1 {
    return hop2(a, b, c, x, d, e, f, g);
}

fn hop2(a: i32, b: i32, c: i32, x: S1, d: i32, e: i32, f: i32, g: i32) -> S1 {
    let mut y: S1 = x;
    y.f0 = y.f0 + 0;
    return hop1(a, b, c, x, d, e, f, g);
}

fn hop1(a: i32, b: i32, c: i32, x: S1, d: i32, e: i32, f: i32, g: i32) -> S1 {
    let mut y: S1 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f0 = y.f0 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S1 = S1 { f0: 12 };
    let r: S1 = hop1(1, 2, 3, v, 4, 5, 6, 7);
    print(r.f0);
    print(r.f0);
    print(scal(1, 2, 3, 4, 5, 6, 7));
    return 0;
}
