// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 4 bytes (1 words), locals=3, kind=param, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S1 {
    f0: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn ident(x: S1, a: i32, b: i32, c: i32) -> S1 {
    let mut y: S1 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f0 = y.f0 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S1 = S1 { f0: 12 };
    let r: S1 = ident(v, 1, 2, 3);
    print(r.f0);
    print(r.f0);
    print(scal(1, 2, 3));
    return 0;
}
