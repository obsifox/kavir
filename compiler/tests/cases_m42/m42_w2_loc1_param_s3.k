// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 8 bytes (2 words), locals=1, kind=param, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S2 {
    f0: i32,
    f1: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn ident(x: S2, a: i32, b: i32, c: i32) -> S2 {
    let mut y: S2 = x;
    y.f0 = y.f0 + 0;
    return y;
}

fn main() -> i32 {
    let v: S2 = S2 { f0: 13, f1: 24 };
    let r: S2 = ident(v, 1, 2, 3);
    print(r.f0);
    print(r.f1);
    print(scal(1, 2, 3));
    return 0;
}
