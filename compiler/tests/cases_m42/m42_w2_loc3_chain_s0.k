// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 8 bytes (2 words), locals=3, kind=chain, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S2 {
    f0: i32,
    f1: i32,
}

fn hop3(x: S2) -> S2 {
    return hop2(x);
}

fn hop2(x: S2) -> S2 {
    let mut y: S2 = x;
    y.f0 = y.f0 + 0;
    return hop1(x);
}

fn hop1(x: S2) -> S2 {
    let mut y: S2 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f1 = y.f1 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S2 = S2 { f0: 13, f1: 24 };
    let r: S2 = hop1(v);
    print(r.f0);
    print(r.f1);
    return 0;
}
