// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 12 bytes (3 words), locals=1, kind=chain, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S3 {
    f0: i32,
    f1: i32,
    f2: i32,
}

fn hop3(x: S3) -> S3 {
    return hop2(x);
}

fn hop2(x: S3) -> S3 {
    let mut y: S3 = x;
    y.f0 = y.f0 + 0;
    return hop1(x);
}

fn hop1(x: S3) -> S3 {
    let mut y: S3 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f2 = y.f2 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S3 = S3 { f0: 14, f1: 25, f2: 36 };
    let r: S3 = hop1(v);
    print(r.f0);
    print(r.f2);
    return 0;
}
