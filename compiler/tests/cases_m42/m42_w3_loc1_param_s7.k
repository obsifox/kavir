// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S3 {
    f0: i32,
    f1: i32,
    f2: i32,
}

fn scal(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32) -> i32 {
    return a + 2 * b + 4 * c + 8 * d + 16 * e + 32 * f + 64 * g;
}

fn ident(a: i32, b: i32, c: i32, x: S3, d: i32, e: i32, f: i32, g: i32) -> S3 {
    let mut y: S3 = x;
    y.f0 = y.f0 + 0;
    return y;
}

fn main() -> i32 {
    let v: S3 = S3 { f0: 14, f1: 25, f2: 36 };
    let r: S3 = ident(1, 2, 3, v, 4, 5, 6, 7);
    print(r.f0);
    print(r.f2);
    print(scal(1, 2, 3, 4, 5, 6, 7));
