// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 12 bytes (3 words), locals=3, kind=chain, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S3 {
    f0: i32,
    f1: i32,
    f2: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn hop3(x: S3, a: i32, b: i32, c: i32) -> S3 {
    return hop2(x, a, b, c);
}

fn hop2(x: S3, a: i32, b: i32, c: i32) -> S3 {
    let mut y: S3 = x;
    y.f0 = y.f0 + 0;
    return hop1(x, a, b, c);
}

fn hop1(x: S3, a: i32, b: i32, c: i32) -> S3 {
    let mut y: S3 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f2 = y.f2 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S3 = S3 { f0: 14, f1: 25, f2: 36 };
    let r: S3 = hop1(v, 1, 2, 3);
    print(r.f0);
    print(r.f2);
    print(scal(1, 2, 3));
    return 0;
}
