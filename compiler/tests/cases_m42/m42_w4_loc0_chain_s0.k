// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 16 bytes (4 words), locals=0, kind=chain, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S4 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
}

fn hop3(x: S4) -> S4 {
    return hop2(x);
}

fn hop2(x: S4) -> S4 {
    let mut y: S4 = x;
    y.f0 = y.f0 + 0;
    return hop1(x);
}

fn hop1(x: S4) -> S4 {
    let mut y: S4 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f3 = y.f3 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S4 = S4 { f0: 15, f1: 26, f2: 37, f3: 48 };
    let r: S4 = hop1(v);
    print(r.f0);
    print(r.f3);
    return 0;
}
