// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 16 bytes (4 words), locals=0, kind=param, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S4 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn ident(x: S4, a: i32, b: i32, c: i32) -> S4 {
    return x;
}

fn main() -> i32 {
    let v: S4 = S4 { f0: 15, f1: 26, f2: 37, f3: 48 };
    let r: S4 = ident(v, 1, 2, 3);
    print(r.f0);
    print(r.f3);
    print(scal(1, 2, 3));
    return 0;
}
