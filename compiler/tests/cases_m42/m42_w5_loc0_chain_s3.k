// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 20 bytes (5 words), locals=0, kind=chain, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S5 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn hop3(x: S5, a: i32, b: i32, c: i32) -> S5 {
    return hop2(x, a, b, c);
}

fn hop2(x: S5, a: i32, b: i32, c: i32) -> S5 {
    let mut y: S5 = x;
    y.f0 = y.f0 + 0;
    return hop1(x, a, b, c);
}

fn hop1(x: S5, a: i32, b: i32, c: i32) -> S5 {
    let mut y: S5 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f4 = y.f4 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S5 = S5 { f0: 16, f1: 27, f2: 38, f3: 49, f4: 60 };
    let r: S5 = hop1(v, 1, 2, 3);
    print(r.f0);
    print(r.f4);
    print(scal(1, 2, 3));
    return 0;
}
