struct S5 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn ident(x: S5, a: i32, b: i32, c: i32) -> S5 {
    let t1: i32 = 7;
    let r: S5 = S5 { f0: x.f0 + t1 * 0 + 0, f1: x.f1 + t1 * 0 + 1, f2: x.f2 + t1 * 0 + 2, f3: x.f3 + t1 * 0 + 3, f4: x.f4 + t1 * 0 + 4 };
    return r;
}

fn main() -> i32 {
    let v: S5 = S5 { f0: 16, f1: 27, f2: 38, f3: 49, f4: 60 };
    let r: S5 = ident(v, 1, 2, 3);
    print(r.f0);
    print(r.f4);
    print(scal(1, 2, 3));
    return 0;
}
