// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 24 bytes (6 words), locals=0, kind=chain, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S6 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn hop3(x: S6, a: i32, b: i32, c: i32) -> S6 {
    return hop2(x, a, b, c);
}

fn hop2(x: S6, a: i32, b: i32, c: i32) -> S6 {
    let mut y: S6 = x;
    y.f0 = y.f0 + 0;
    return hop1(x, a, b, c);
}

fn hop1(x: S6, a: i32, b: i32, c: i32) -> S6 {
    let mut y: S6 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f5 = y.f5 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S6 = S6 { f0: 17, f1: 28, f2: 39, f3: 50, f4: 61, f5: 72 };
    let r: S6 = hop1(v, 1, 2, 3);
    print(r.f0);
    print(r.f5);
    print(scal(1, 2, 3));
    return 0;
}
