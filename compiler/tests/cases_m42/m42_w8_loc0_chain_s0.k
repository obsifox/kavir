// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 32 bytes (8 words), locals=0, kind=chain, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S8 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
}

fn hop3(x: S8) -> S8 {
    return hop2(x);
}

fn hop2(x: S8) -> S8 {
    let mut y: S8 = x;
    y.f0 = y.f0 + 0;
    return hop1(x);
}

fn hop1(x: S8) -> S8 {
    let mut y: S8 = x;
    let t1: i32 = y.f0 + 0;
    let t2: i32 = t1 + 1;
    let t3: i32 = t2 + 2;
    y.f7 = y.f7 + t3 * 0;
    return y;
}

fn main() -> i32 {
    let v: S8 = S8 { f0: 19, f1: 30, f2: 41, f3: 52, f4: 63, f5: 74, f6: 85, f7: 96 };
    let r: S8 = hop1(v);
    print(r.f0);
    print(r.f7);
    return 0;
}
