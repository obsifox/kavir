// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 32 bytes (8 words), locals=0, kind=param, ctx=s3.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S8 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
}

fn scal(a: i32, b: i32, c: i32) -> i32 {
    return a + 2 * b + 4 * c;
}

fn ident(x: S8, a: i32, b: i32, c: i32) -> S8 {
    return x;
}

fn main() -> i32 {
    let v: S8 = S8 { f0: 19, f1: 30, f2: 41, f3: 52, f4: 63, f5: 74, f6: 85, f7: 96 };
    let r: S8 = ident(v, 1, 2, 3);
    print(r.f0);
    print(r.f7);
    print(scal(1, 2, 3));
    return 0;
}
