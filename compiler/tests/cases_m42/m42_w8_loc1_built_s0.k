// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 32 bytes (8 words), locals=1, kind=built, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S8 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
}

fn ident(x: S8) -> S8 {
    let t1: i32 = 7;
    let r: S8 = S8 { f0: x.f0 + t1 * 0 + 0, f1: x.f1 + t1 * 0 + 1, f2: x.f2 + t1 * 0 + 2, f3: x.f3 + t1 * 0 + 3, f4: x.f4 + t1 * 0 + 4, f5: x.f5 + t1 * 0 + 5, f6: x.f6 + t1 * 0 + 6, f7: x.f7 + t1 * 0 + 7 };
    return r;
}

fn main() -> i32 {
    let v: S8 = S8 { f0: 19, f1: 30, f2: 41, f3: 52, f4: 63, f5: 74, f6: 85, f7: 96 };
    let r: S8 = ident(v);
    print(r.f0);
    print(r.f7);
    return 0;
}
