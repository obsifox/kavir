// M4.2 regression matrix (ADR-011; verification round 2 bug 1):
// 32 bytes (8 words), locals=1, kind=param, ctx=s0.
// Generated by scripts/gen_m42_matrix.py -- do not edit.
struct S8 {
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
}

fn ident(x: S8) -> S8 {
    let mut y: S8 = x;
    y.f0 = y.f0 + 0;
    return y;
}

fn main() -> i32 {
    let v: S8 = S8 { f0: 19, f1: 30, f2: 41, f3: 52, f4: 63, f5: 74, f6: 85, f7: 96 };
    let r: S8 = ident(v);
    print(r.f0);
    print(r.f7);
    return 0;
}
